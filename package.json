{
  "name": "vkc-keralotsavam-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Variayan Kunan Club - Keralotsavam Registration & Management API",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "seed": "node scripts/seed.js",
    "fonts": "node scripts/fetchFonts.js",
    "build:datasets": "node scripts/buildDatasets.js",
    "import:competitions": "node scripts/importCompetitions.js",
    "import:gallery": "node scripts/importGallery.js",
    "verify:import": "node scripts/verifyImport.js",
    "purge:retention": "node scripts/purgeRetention.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.8",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.2",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "pdfkit": "^0.20.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
